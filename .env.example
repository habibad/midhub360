# Midhub360 Environment Configuration
# Copy this file to .env to override defaults

# Environment mode: local, development, or production
APP_ENV=local

# Application Base URL
APP_URL=http://localhost/midhub360.com

# Database Configuration
# Localhost default:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=midhub-db
DB_USER=root
DB_PASS=

# Live Server (Production) Configuration example:
# APP_ENV=production
# APP_URL=https://midhub360.com
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=midhub-db
# DB_USER=midhubDBuser
# DB_PASS=2345Midh@b#4$2025

# API Mode: true for testing/sandbox, false for production
IS_SANDBOX=true

