# Midhub360 Environment Configuration
# Copy this file to .env (never commit .env). On the server: chmod 600 .env, owner www-data.

# Environment mode: local, development, or production
APP_ENV=local

# Public base URL, used to build gateway callback/webhook URLs. Must be https:// in production.
APP_URL=http://localhost/midhub360.com

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=midhub-db
DB_USER=root
DB_PASS=

# Encryption key for gateway credentials and voucher PINs (AES-256-GCM).
# Generate once:  php -r "echo 'base64:' . base64_encode(random_bytes(32)), PHP_EOL;"
# BACK IT UP. If it is lost, saved gateway credentials must be re-entered in Gateway Settings.
# If unset, a key is auto-generated at storage/keys/app.key on first use.
APP_KEY=

# Optional: lets an HTTP cron caller run admin/api_status_update_recharge.php etc. by sending
# header "X-Cron-Token: <value>". Use 24+ random characters. CLI cron needs no token.
CRON_TOKEN=

# Optional: also email System Alerts (low provider balance, deposits held for review).
ALERT_EMAIL=

# API Mode: true for testing/sandbox, false for production (legacy flag; gateway modes are
# now switched per gateway in Admin > Payment Gateways > Gateway Settings)
IS_SANDBOX=true
