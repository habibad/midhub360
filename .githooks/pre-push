#!/usr/bin/env bash
# Second line of defence: scans every commit about to be pushed to GitHub (catches commits made
# on a machine without the pre-commit hook, or with --no-verify).
root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue                     # branch deletion
    if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        range="$local_sha --not --remotes"                     # new branch / unknown remote state
    else
        range="$remote_sha..$local_sha"
    fi
    bash "$root/tools/secret-scan.sh" --range "$range" || status=1
done
exit $status
